FROM python:3.10-slim

WORKDIR /app

# Install system dependencies required for OpenCV and face recognition
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_backend.txt .
RUN pip install --no-cache-dir -r requirements_backend.txt

COPY backend/ ./backend/
COPY data/ ./data/

# Create directories that are expected to exist
RUN mkdir -p uploads/users uploads/admins uploads/registered uploads/attendance_logs uploads/enrollments

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
